<h1>Edit Trimester: <%= "#{@trimester.term} #{@trimester.year}" %></h1>

<%= form_with(model: @trimester, local: true) do |form| %>
  <% if @trimester.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@trimester.errors.count, "error") %> prohibited this trimester from being saved:</h2>
      <ul>
        <% @trimester.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :application_deadline, "Application Deadline" %>
    <%= form.text_field :application_deadline, class: 'form-control', value: @trimester.application_deadline %>
  </div>

  <%= form.submit "Update Trimester" %>
<% end %>

<%= link_to "Back", trimester_path(@trimester) %>
